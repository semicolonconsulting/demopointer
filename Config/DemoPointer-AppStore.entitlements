<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The Mac App Store copy: the App Sandbox and nothing else. No network access, since the
         App Store handles updates. Used by scripts/release-appstore.sh. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
